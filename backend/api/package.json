{
  "name": "@raynex/api",
  "version": "1.2.0-dev.3",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "test": "jest --config ./jest.config.js --passWithNoTests",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/data-source.ts",
    "test:watch": "jest --watch",
    "dev": "nest start --watch",
    "verify:dist": "node -e \"require('fs').accessSync('dist/main.js')\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:cov": "jest --config ./jest.config.js --coverage --passWithNoTests",
    "migration:run:prod": "typeorm migration:run -d dist/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "@nestjs/mapped-types": "^2.0.6",
    "@nestjs/jwt": "^10.2.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "@types/bcryptjs": "^2.4.6"
  },
  "engines": {
    "node": ">=20"
  }
}
